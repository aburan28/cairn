<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>Cairn</string>
	<key>CFBundleIdentifier</key><string>org.cairn.app</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Cairn</string>
	<key>CFBundleDisplayName</key><string>Cairn</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<!-- A checkout's build says 0.0.0; packaging/macos/build-dmg.sh stamps the
	     release's version over both of these before it signs the bundle.
	     The updater reads CFBundleShortVersionString to decide whether a
	     release is newer, and 0.0.0 as "development build": checked, never
	     replaced in place (Sources/Cairn/Version.swift). -->
	<key>CFBundleShortVersionString</key><string>0.0.0</string>
	<key>CFBundleVersion</key><string>0.0.0</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>NSHumanReadableCopyright</key><string>Copyright © The cairn contributors. See LICENSE.</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<!-- The reader is served by the node over plain HTTP on loopback. -->
	<key>NSAppTransportSecurity</key>
	<dict><key>NSAllowsLocalNetworking</key><true/></dict>
	<!-- Asked when P2P is bound past loopback, or when the node looks for
	     peers on the local segment. Without it, macOS 15 quietly denies the
	     multicast beacon and the node looks isolated for no visible reason. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cairn finds other nodes on this network and, when you allow inbound connections, answers their dials.</string>
</dict>
</plist>
