<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>Cairn</string>
	<key>CFBundleIdentifier</key><string>org.cairn.app</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Cairn</string>
	<key>CFBundleDisplayName</key><string>Cairn</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<!-- A checkout's build says 0.0.0; packaging/macos/build-dmg.sh stamps the
	     release's version over both of these before it signs the bundle. -->
	<key>CFBundleShortVersionString</key><string>0.0.0</string>
	<key>CFBundleVersion</key><string>0.0.0</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>NSHumanReadableCopyright</key><string>Copyright © The cairn contributors. See LICENSE.</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<!-- The reader is served by the node over plain HTTP on loopback. -->
	<key>NSAppTransportSecurity</key>
	<dict><key>NSAllowsLocalNetworking</key><true/></dict>
	<!-- Check for Updates… (Sources/Cairn/Updates.swift). The feed is on a
	     fixed release tagged `updates`, where release.yml overwrites it once
	     a release's .dmg is up and its feed verifies. Fixed rather than
	     releases/latest, which moves to a new release the moment it is
	     published and answers 404 until that release's .dmg job has run;
	     a check in that window then reads the previous feed and says "up to
	     date" instead of failing.
	     SUPublicEDKey (Ed25519, Sparkle's check of the image) and
	     CairnMLDSA87PublicKey (ML-DSA-87, the app's own post-quantum check of
	     the feed item) are not here: build-dmg.sh writes them from the
	     release's signing key, and a build without them does not start the
	     updater. -->
	<key>SUFeedURL</key>
	<string>https://github.com/aburan28/cairn/releases/download/updates/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key><true/>
	<key>SUScheduledCheckInterval</key><integer>86400</integer>
	<!-- Asked when P2P is bound past loopback, or when the node looks for
	     peers on the local segment. Without it, macOS 15 quietly denies the
	     multicast beacon and the node looks isolated for no visible reason. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cairn finds other nodes on this network and, when you allow inbound connections, answers their dials.</string>
	<!-- Dictation in New Challenge… (Sources/Cairn/Dictation.swift): the
	     microphone, and speech recognition on this Mac where macOS offers it.
	     Asked the first time the microphone button is pressed, never before.
	     The signed build also carries the audio-input entitlement
	     (packaging/macos/Cairn.entitlements), which the hardened runtime
	     requires for the microphone at all. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Cairn listens while you dictate a challenge description in New Challenge, and at no other time.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Cairn turns what you dictate into the text of a challenge description. Recognition runs on this Mac when macOS supports it for your language.</string>
	<!-- A data folder or bootstrap file chosen outside the app's own folder.
	     macOS asks before the node reads these places; the reason it shows is
	     one of these, and a bundle without them is refused without a word. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Cairn reads a data folder or bootstrap file you chose on the Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Cairn reads a data folder or bootstrap file you chose in Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Cairn reads a bootstrap file or a toolchain you downloaded.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Cairn reads and writes the data folder you chose on an external disk.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Cairn reads and writes the data folder you chose on a network volume.</string>
</dict>
</plist>
