  "name": "ecc2k130-orbit-walk",
  "objective": "sha256:f59556b4b74664f6c7326e21240bee831a1db2a3bdeab7d60538176f67fd158c",
  "resources": {
    "memory_mb": 256,
    "round_seconds": 600
  },
  "summary": "Walks the shared ECC2K-130 Pollard rho on every CPU thread offered, natively (arm64 PMULL, x86-64 PCLMULQDQ), and submits the distinguished orbits it reaches with their witnesses. A trail averages about 2^25 steps; one 2024-class core reaches one every few seconds. Rounds last ten minutes, and each orbit is re-checked against its witness before it is submitted. CPU only.",
  "targets": {
    "darwin-arm64": {
      "args": [
        "--job",
        "jobs/ecc2k130.json",
        "--lanes",
        "16"
      ],
      "entry": "bin/ecc2k130-orbit-darwin-arm64"
    },
    "linux-x86_64": {
      "args": [
        "--job",
        "jobs/ecc2k130.json",
        "--lanes",
        "16"
      ],
      "entry": "bin/ecc2k130-orbit-linux-x86_64"
    }
  },
