{$CAIRN_MCP_DOMAIN} {
    handle /mcp {
        # Give each trusted agent its own credential. Caddy expects password
        # hashes here; generate them with `caddy hash-password`.
        basic_auth {
            agent_americas {$CAIRN_MCP_AGENT_AMERICAS_HASH}
            agent_europe {$CAIRN_MCP_AGENT_EUROPE_HASH}
        }
        reverse_proxy 127.0.0.1:8001 {
            # Cairn refuses public Host authorities even from a loopback proxy.
            header_up Host 127.0.0.1:8001
            header_up -Authorization
        }
    }
    handle {
        respond 404
    }
}
