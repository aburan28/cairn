# Loopback-only reverse proxy for a hub reachable through Tailscale Serve.
# Public DNS and public internet exposure are unsupported.
:8082 {
	bind 127.0.0.1
	handle /mcp {
		reverse_proxy 127.0.0.1:8001 {
			header_up Host 127.0.0.1:8001
			# Preserve Authorization: Bearer so Cairn selects the right profile.
		}
	}
	handle {
		respond 404
	}
}
