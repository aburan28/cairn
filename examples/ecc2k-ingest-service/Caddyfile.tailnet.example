# Loopback-only proxy behind Tailscale Serve. Tailnet ACLs restrict which
# enrolled devices can reach the service; Cairn's Bearer token selects the
# agent profile and signer. Do not expose this listener to the public internet.
:8082 {
	bind 127.0.0.1
	handle /mcp {
		reverse_proxy 127.0.0.1:8001 {
			header_up Host 127.0.0.1:8001
			# Preserve Authorization: Bearer so Cairn selects the right profile.
		}
	}
	handle {
		respond 404
	}
}
