# A fleet leader on a Linux host: the node that holds the signing identity the
# fleet is paid to, serves its workers over HTTP on the private network, and
# -- its own choice -- peers with the public network or nobody.
#
# The Mac in front of you can be the leader instead (Cairn.app, Settings ->
# Fleet); this unit is for a leader that lives in a rack or a cloud account.
# docs/fleet.md is the walk-through.
#
# Install:
#
#   sudo useradd --system --home /var/lib/cairn --create-home cairn
#   sudo install -m 755 cairn /usr/local/bin/cairn
#   sudo -u cairn /usr/local/bin/cairn identity --out /var/lib/cairn/leader.identity.json
#   sudo install -m 644 leader.service /etc/systemd/system/cairn-leader.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cairn-leader
#   curl -s http://127.0.0.1:8080/network | python3 -c 'import json,sys; print(json.load(sys.stdin)["node"]["fleet"])'
#
# The last line prints whom this leader signs for and the id it signs as.
# Then invite each machine that will work for it, and hand the token over out
# of band (docs/fleet.md):
#
#   sudo -u cairn CAIRN_DATA=/var/lib/cairn /usr/local/bin/cairn fleet invite \
#       --identity /var/lib/cairn/leader.identity.json --prefix rented --uses 16 \
#       --member-ttl 12h --node http://THIS-HOST:8080

[Unit]
Description=cairn fleet leader (signs the fleet's records; serves workers on the private network)
After=network-online.target
Wants=network-online.target

[Service]
User=cairn
WorkingDirectory=/var/lib/cairn
Environment=CAIRN_DATA=/var/lib/cairn
Environment=CAIRN_LOG_LEVEL=info
# Whose unsigned records this node signs as itself. `enrolled`: the machines
# you invited with `cairn fleet invite`, each proving its own key on every
# request, from any address -- a rented GPU needs no tunnel, and a stranger on
# the network gets nothing signed. Networks are the older way, kept for
# compatibility: `private` (10/8, 172.16/12, 192.168/16, loopback, IPv6
# unique-local), `loopback`, or CIDRs trust every address inside them with no
# proof, and `enrolled,loopback` adds this host's own tools to the members.
Environment=CAIRN_FLEET=enrolled
# The ed25519 identity the fleet is paid to. Kept here, on the leader, and
# nowhere else: a worker never holds it.
Environment=CAIRN_FLEET_IDENTITY=/var/lib/cairn/leader.identity.json
# A fleet is private by default: no public seeds, no LAN beacons, no router
# port mapping, and p2p only with the peers named in --bootstrap files (none
# here). Remove these three lines, or set CAIRN_PEERS=open, for a leader that
# also joins the public network.
Environment=CAIRN_SEEDS=off
Environment=CAIRN_BEACON_PORT=off
Environment=CAIRN_PORTMAP=off
Environment=CAIRN_ROLES=coordinator,verifier
# --no-mcp: stdin belongs to systemd. --serve on the wildcard so workers reach
# the HTTP side. With `enrolled` alone it may face the internet: what anyone
# can do there is what they can do at any public seed, and nothing gets signed
# for them. With a network in CAIRN_FLEET, the firewall or security group must
# keep the HTTP side to that network, because the address is the credential.
# --listen on loopback: this leader peers with nobody over p2p; bind
# 0.0.0.0:9000 and add --bootstrap files to peer with a fleet node in another
# region.
ExecStart=/usr/local/bin/cairn run --no-mcp \
    --listen 127.0.0.1:9000 \
    --serve 0.0.0.0:8080 \
    --mcp-identity /var/lib/cairn/leader.identity.json
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
