# A fleet worker: one search loop, on one objective, under systemd.
#
# The reference loop is examples/certicom-ecdlp/tools/orbit_worker.py, which
# asks the leader for its slice each epoch, heartbeats, and submits what it
# found. Under a fleet the worker submits under the LEADER's identity -- the
# `signs_as` id GET /network publishes -- and the leader signs the record on
# the way into its queue, so the pay lands on the leader and the worker never
# holds a key. The worker's own name is still its own: the work slice is a
# function of the name, and a fleet of workers under one name would all walk
# the same slice.
#
# One instance per objective (or per GPU, or per anything): the instance name
# picks the environment file.
#
#   sudo install -m 644 worker@.service /etc/systemd/system/cairn-worker@.service
#   sudo mkdir -p /etc/cairn && sudo install -m 640 worker.env.example /etc/cairn/worker-ecc2k130.env
#   sudo $EDITOR /etc/cairn/worker-ecc2k130.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now cairn-worker@ecc2k130
#   journalctl -u cairn-worker@ecc2k130 -f
#
# The host itself is registered with the leader separately, by `cairn agent
# install --node http://LEADER:8080` (docs/agent.md): the agent says what the
# machine is and runs sandboxed jobs; this unit is a worker that walks.
# Replace ExecStart with your own walker -- the GPU client from the ECC2K-130
# campaign, for instance -- as long as it speaks the same four routes
# (GET /work_assignment, POST /progress, POST /submit?kind=commitment|claim).

[Unit]
Description=cairn fleet worker %i (walks a search and submits to the leader)
After=network-online.target
Wants=network-online.target

[Service]
User=cairn
WorkingDirectory=/var/lib/cairn
EnvironmentFile=/etc/cairn/worker-%i.env
# From the environment file: CAIRN_LEADER (the leader's HTTP base URL, on the
# private network or through a tunnel), CAIRN_OBJECTIVE (the objective id),
# CAIRN_JOB (the search job file the objective pins), CAIRN_SUBMITTER (the
# leader's `signs_as` id), CAIRN_WORKER (this worker's own name; defaults to
# the instance name), CAIRN_PARTITIONS (how many slices the fleet splits
# into; the same number on every worker).
ExecStart=/usr/bin/python3 /opt/cairn/tools/orbit_worker.py \
    --node ${CAIRN_LEADER} \
    --objective ${CAIRN_OBJECTIVE} \
    --job ${CAIRN_JOB} \
    --worker ${CAIRN_WORKER} \
    --submitter ${CAIRN_SUBMITTER} \
    --partitions ${CAIRN_PARTITIONS}
Restart=always
RestartSec=10
# A walker holds nothing that needs a graceful stop: its slice is re-asked each
# epoch, its heartbeats expire, and a batch it had not committed is walked
# again by whoever draws the slice next.
TimeoutStopSec=15

# Hardening. A walker reads its job file, talks HTTP to the leader, and
# writes nothing outside /var/lib/cairn. A GPU walker needs /dev/nvidia*:
# add `DeviceAllow=` lines (and drop PrivateDevices) for one.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cairn
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
